# Deployment values and credentials. Copy to .env and fill in (.env is gitignored).
# Variables already set in the real environment (Docker, CI) win over this file.
# The pipeline definition (station, parameters, ranges, ...) is in config/settings.yaml.

# Required. Feature store location: a GCS bucket path.
STORAGE_URI=gs://<bucket>/soil-moisture
# Service-account key for the bucket (local runs only; CI uses the GCP_SA_KEY secret).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# MLflow on DagsHub (used from MS3 on).
# MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
# MLFLOW_TRACKING_USERNAME=<user>
# MLFLOW_TRACKING_PASSWORD=<dagshub-token>
